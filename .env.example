# HitPay sandbox only. Real credentials belong in private hosting settings.
# Never commit real keys or use a VITE_ prefix.
HITPAY_API_KEY=
HITPAY_SALT_KEY=
HITPAY_API_BASE_URL=https://api.sandbox.hit-pay.com

# Event webhooks use their own endpoint salt, NOT the API-key salt.
HITPAY_WEBHOOK_SALT=
HITPAY_BUSINESS_ID=
HITPAY_SANDBOX_PLAN_ID=
HITPAY_SANDBOX_RETURN_URL=

# J2/J3 email delivery — private server-side settings (Preview only).
# The Resend test sender can send only to your Resend account email.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
# Proposed allowlist for controlled email testing; set privately in Vercel.
RESEND_TEST_RECIPIENT=

# Wix development CMS — server only; never use a VITE_ prefix.
WIX_DEV_SITE_ID=09d613aa-3a95-42ff-9ee3-2aa0c706c447
WIX_DEV_DATA_API_KEY=

# Proposed server-side authentication secret; generate privately (32+ random bytes).
PARENT_AUTH_SECRET=

# Company J3 configuration contract (new adapter; not enabled for live operation).
HITPAY_API_URL=
HITPAY_SALT=
HITPAY_PLAN_ID=
HITPAY_CURRENCY=
HITPAY_MEMBERSHIP_AMOUNT=
HITPAY_DEPOSIT_AMOUNT=

# J1 private Preview only. Keep primary recipient above; allow up to four additional approved inboxes.
# Comma-separated addresses; leave blank until approved. Sender must be on a verified development domain.
PARENT_PREVIEW_RECIPIENTS=
PARENT_PREVIEW_VERIFIED_SENDER=

PARENT_PREVIEW_OPEN_EMAIL=0

STUDENT_AUTH_ENABLED=false

STUDENT_AUTH_SECRET=

# J12345 fictional isolated preview; never enable in production.
J12345_REGISTRATION_ENABLED=0
J12345_PROFILE_ENABLED=0
J12345_AUTH_ROOT=
J12345_TEST_EMAILS=

# J12345 payment and attendance gates (fictional private preview only)
J12345_BILLING_ENABLED=0
J12345_BILLING_READ_ENABLED=0
J12345_ATTENDANCE_ENABLED=0
J12345_ATTENDANCE_OPERATOR_ENABLED=0
J12345_TEST_OPERATOR_ENABLED=0
J12345_TEST_OPERATOR_SECRET=
J12345_PROVIDER_ACCEPTED=0
J12345_MEMBERSHIP_WORKER_SECRET=

# Private course gate; no entitlement or storage provider is enabled yet.
J12345_COURSE_ENABLED=0

# Phase 06: private progress collection and approved exact policy hash; defaults off.
J12345_PROGRESS_ENABLED=0
J12345_PROGRESS_POLICY_VERSION=
J12345_PROGRESS_POLICY_SHA256=

# Phase 07 assessments. Course and progress gates also required; keep disabled until verified.
J12345_ASSESSMENT_ENABLED=0

# Phase 08: read-only integrated private staff directory and learning metrics.
J12345_STAFF_LEARNING_ENABLED=0

# Owner-approved 60-minute session policy. Activation requires separate private acceptance.
J12345_LEARNING_SESSION_ENABLED=0

# Nizar private development scheduling; enable only after separate acceptance.
NIZAR_SCHEDULING_ENABLED=0
